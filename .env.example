# Supabase (Vercel의 Supabase 연동을 쓰면 자동으로 들어감)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 예전 이름도 지원: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (서버 전용, 브라우저로 내려가지 않음). 비워 두면 AI 기능은 꺼진 상태로 동작
GEMINI_API_KEY=
# 선택: 안 C(국방망 내부 AI 등 Gemini 호환 API)로 바꿀 때
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=20000
