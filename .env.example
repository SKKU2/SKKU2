# Supabase (Project Settings → API Keys). 둘 다 비우면 개발 PC에서 "로컬 체험 모드"로 동작
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 예전 이름도 지원: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀 키 (sb_secret_… 또는 service_role). 관리자의 계정 발급·초기화·정지·삭제에 사용
# 브라우저로 내려가지 않는다. 절대 NEXT_PUBLIC_ 이름으로 넣지 말 것
SUPABASE_SECRET_KEY=
# 최초 설치(/setup) 화면에서 첫 총괄관리자를 만들 때 쓰는 설치 코드. 총괄관리자가 생기면 화면이 닫힌다
SETUP_CODE=

# Gemini (서버 전용). 비워 두면 AI 기능은 꺼진 상태로 동작
GEMINI_API_KEY=
# 선택: 안 C(국방망 내부 AI 등 Gemini 호환 API)로 바꿀 때
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=20000

# 선택: 배포 환경에서 Supabase 없이 로컬 체험 모드를 강제로 켤 때만 (보통 쓰지 않음)
# LOCAL_MODE=1
