# Supabase (Project Settings → API). 둘 다 비우면 개발 PC에서 "로컬 체험 모드"로 동작
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 예전 이름도 지원: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini (서버 전용, 브라우저로 내려가지 않음). 비워 두면 AI 기능은 꺼진 상태로 동작
GEMINI_API_KEY=
# 선택: 안 C(국방망 내부 AI 등 Gemini 호환 API)로 바꿀 때
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=20000

# 선택: 배포 환경에서 Supabase 없이 로컬 체험 모드를 강제로 켤 때만 (보통 쓰지 않음)
# LOCAL_MODE=1
